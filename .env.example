# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890

# MT5 / XM account (only needed when DRY_RUN=false)
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=XMGlobal-MT5
MT5_TERMINAL_PATH=

# true = simulate prices/account, no real MT5 connection or orders (safe for testing)
# false = connect to the real MT5 terminal and place real orders
DRY_RUN=true

# Path to config/config.yaml (copy from config/config.example.yaml)
CONFIG_PATH=config/config.yaml
